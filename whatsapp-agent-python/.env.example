# Puerto donde se expone el puente de WhatsApp
PORT=3000

# --- TU agente (endpoint HTTP/REST) ---
# Cámbialo por la URL de tu nuevo agente
AGENT_URL=http://localhost:8000/chat
# Token de autenticación, si tu agente lo pide (se manda como Bearer). Vacío si no.
AGENT_API_KEY=
# Espera máxima por respuesta del agente, en milisegundos (3 min)
AGENT_TIMEOUT_MS=180000

# --- WhatsApp ---
WA_SESSION_DB=./neonize.db
REPLY_IN_GROUPS=false
